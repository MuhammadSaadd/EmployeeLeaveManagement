@using EmployeeLeaveManagement.Infrastructure.Identity
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Leave Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body class="elm-body">
<header>
    <nav class="navbar navbar-expand-lg navbar-dark elm-nav">
        <div class="container">
            <a class="navbar-brand fw-semibold" asp-controller="Dashboard" asp-action="Index">LeaveDesk</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="LeaveRequests" asp-action="Index">My / All Requests</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="LeaveRequests" asp-action="Apply">Apply Leave</a>
                        </li>
                        @if (User.IsInRole(AppRoles.Manager))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="LeaveApprovals" asp-action="Index">Approvals</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Employees" asp-action="Index">Employees</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="LeaveTypes" asp-action="Index">Leave Types</a>
                            </li>
                        }
                    </ul>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex">
                        @Html.AntiForgeryToken()
                        <span class="navbar-text text-white-50 me-3 d-none d-md-inline">@User.Identity?.Name</span>
                        <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                    </form>
                }
            </div>
        </div>
    </nav>
</header>

<div class="container py-4">
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="alert">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }
    <main role="main">
        @RenderBody()
    </main>
</div>

<footer class="border-top elm-footer py-3 mt-auto">
    <div class="container text-muted small">
        &copy; @DateTime.UtcNow.Year LeaveDesk — Employee Leave Management
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
