@model EmployeeLeaveManagement.ViewModels.LeaveTypes.LeaveTypeFormViewModel
@{
    ViewData["Title"] = "Create Leave Type";
}

<h1 class="h3 mb-3">Create Leave Type</h1>
<div class="card card-form">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control"/>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="MaximumDaysAllowed" class="form-label"></label>
                <input asp-for="MaximumDaysAllowed" class="form-control"/>
                <span asp-validation-for="MaximumDaysAllowed" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
