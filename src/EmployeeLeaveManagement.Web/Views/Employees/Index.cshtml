@model IReadOnlyList<EmployeeLeaveManagement.Application.Employees.Models.EmployeeDto>
@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Employees</h1>
    <a class="btn btn-primary" asp-action="Create">Add Employee</a>
</div>

<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table table-hover mb-0 align-middle">
        <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Department</th>
            <th>Email</th>
            <th>Phone</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.EmployeeCode</td>
                <td>@employee.Name</td>
                <td>@employee.Department</td>
                <td>@employee.Email</td>
                <td>@employee.PhoneNumber</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@employee.Id">Edit</a>
                    <form asp-action="Delete" asp-route-id="@employee.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Delete this employee?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
