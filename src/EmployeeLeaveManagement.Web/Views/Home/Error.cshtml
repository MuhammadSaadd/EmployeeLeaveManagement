@{
    ViewData["Title"] = "Error";
}

<div class="alert alert-danger">
    <h1 class="h4">Something went wrong</h1>
    <p class="mb-0">An error occurred while processing your request.</p>
    @if (ViewData["RequestId"] is string requestId)
    {
        <p class="small mt-2 mb-0">Request ID: @requestId</p>
    }
</div>
